# Demo mode; set true to bypass Stash entirely and serve mock content
DEMO_MODE=false

# Stash instance
STASH_URL=http://localhost:9999
STASH_API_KEY=
STASH_TAGS_EXCLUDED=exclude1,exclude2
STASH_TAGS_INCLUDED=

# App
PUBLIC_APP_URL=http://localhost:9456
PUBLIC_APP_ORIGINS=http://localhost
PUBLIC_AUTH_COOKIE_SECURE=false
DB_PATH=./data/substash.db
SHARE_SECRET=your_share_secret_here

# Emergency PIN override, which bypasses the stored PIN if set. Clear after use.
PIN_OVERRIDE=
