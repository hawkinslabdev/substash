{
  "name": "substash",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev --port 9456",
    "build": "astro build",
    "start": "node server.mjs",
    "preview": "astro preview --port 9456",
    "lint": "prettier --check .",
    "check": "astro check && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "codegen": "tsx scripts/codegen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "prepare": "cd .. && husky substash/.husky"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/solid-js": "^7.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-query": "^5.104.0",
    "astro": "^7.3.5",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "solid-js": "^1.9.15",
    "solid-motionone": "^1.0.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.4",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@emnapi/runtime": "^1.11.3",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
