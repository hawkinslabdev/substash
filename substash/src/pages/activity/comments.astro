---
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import { db } from "@/lib/db";
import { comments, type Comment } from "@/lib/db/schema";
import { desc } from "drizzle-orm";
import { proxyImage } from "@/lib/stash/image";
import { timeAgo, renderMarkdown } from "@/lib/utils/markdown";

function stillThumb(url: string | null | undefined): string | null {
  if (!url) return null;
  if (url.includes("/preview") || /\.(mp4|webm|mov)(\?|$)/i.test(url)) return null;
  return url;
}
import { sanitize } from "@/lib/utils/sanitize";

const rows: Comment[] = db.select().from(comments).orderBy(desc(comments.createdAt)).limit(50).all();

function renderBody(body: string): string {
  return body.trimStart().startsWith("<") ? sanitize(body) : renderMarkdown(body);
}

function excerpt(html: string, max = 120): string {
  const text = html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  return text.length > max ? text.slice(0, max).trimEnd() + "…" : text;
}
---

<PageShell title="Substash: Recent Comments">
  <header class="header-glass sticky top-0 z-10 px-4 py-3 flex items-center gap-3">
    <button onclick="history.back()" aria-label="Go back" class="text-[var(--color-text-muted)]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <p class="text-sm font-medium">Recent Comments</p>
  </header>

  {rows.length === 0 ? (
    <div class="flex flex-col items-center justify-center min-h-[50dvh] gap-3 px-6 text-center">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-text-muted)]">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <div class="space-y-1">
        <p class="text-sm font-semibold text-[var(--color-text)]">No comments yet</p>
        <p class="text-xs text-[var(--color-text-muted)] max-w-[240px] leading-relaxed">
          Comment on something you've discovered and it'll appear here.
        </p>
      </div>
    </div>
  ) : (
    <ul class="divide-y divide-[var(--color-border)]">
      {rows.map((comment) => {
        const meta = (() => {
          try { return comment.metadata ? JSON.parse(comment.metadata) : null; }
          catch { return null; }
        })();
        const href = `/${comment.mediaType}s/${comment.stashId}#`; // Eventually forward this to #comments
        const thumb = proxyImage(stillThumb(meta?.thumbnailUrl));
        const title = meta?.title ?? null;
        const date = new Date(comment.createdAt);
        return (
          <li>
            <a href={href} class="flex items-start gap-3 px-4 py-3 hover:bg-[var(--color-surface-2)] transition-colors">
              {thumb ? (
                <img
                  src={thumb}
                  alt=""
                  width="48"
                  height="48"
                  class="w-12 h-12 rounded-lg object-cover shrink-0 bg-[var(--color-surface-3)] mt-0.5"
                  loading="lazy"
                />
              ) : (
                <div class="w-12 h-12 rounded-lg bg-[var(--color-surface-3)] shrink-0 flex items-center justify-center mt-0.5">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-text-muted)]">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                </div>
              )}
              <div class="flex-1 min-w-0">
                {title && <p class="text-xs font-medium text-[var(--color-accent)] truncate mb-0.5">{title}</p>}
                <p class="text-sm text-[var(--color-text)] leading-snug">
                  {excerpt(renderBody(comment.body))}
                </p>
                <time class="text-xs text-[var(--color-text-muted)] mt-1 block" datetime={date.toISOString()} title={date.toLocaleString()}>
                  {timeAgo(date)}{comment.parentId ? " · reply" : ""}
                </time>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}

  <BottomNav slot="nav" />
</PageShell>
