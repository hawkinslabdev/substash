---
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import SearchResults from "@/components/search/SearchResults.solid";
import { db } from "@/lib/db";
import { settings } from "@/lib/db/schema";
import { eq } from "drizzle-orm";

function getSetting(key: string, fallback: string): string {
  return db.select().from(settings).where(eq(settings.key, key)).get()?.value ?? fallback;
}

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const initialFilter = Astro.url.searchParams.get("filter") ?? "all";
const pageNameTags = getSetting("page_name_tags", "Tags");
const pageNamePerformers = getSetting("page_name_performers", "Creators");
const pageNameStudios = getSetting("page_name_studios", "Studios");

const browseLinks = [
  {
    href: "/tags",
    label: pageNameTags,
    desc: `Browse all ${pageNameTags.toLowerCase()}`,
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line stroke-linecap="round" x1="7" y1="7" x2="7.01" y2="7"/>`,
  },
  {
    href: "/performers",
    label: pageNamePerformers,
    desc: `Browse ${pageNamePerformers.toLowerCase()}`,
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`,
  },
  {
    href: "/studios",
    label: pageNameStudios,
    desc: `Browse ${pageNameStudios.toLowerCase()}`,
    svg: `<rect x="2" y="3" width="20" height="14" rx="2"/><path stroke-linecap="round" d="M8 21h8M12 17v4"/>`,
  },
  {
    href: "/discover",
    label: "Discover",
    desc: "Random picks",
    svg: `<circle cx="12" cy="12" r="10"/><polygon stroke-linecap="round" stroke-linejoin="round" points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`,
  },
];
---

<PageShell title={q ? `Search: ${q} — Substash` : "Substash: Search"}>
  <!-- Mobile-only sticky header with search input -->
  <header class="lg:hidden sticky top-0 z-10 px-4 py-3 bg-[var(--color-surface)]/95 backdrop-blur border-b border-[var(--color-border)] flex items-center gap-3">
    <button onclick="history.back()" aria-label="Go back" class="text-[var(--color-text-muted)] shrink-0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/>
      </svg>
    </button>
    <form id="mobile-search-form" action="/search" method="get" class="flex-1" autocomplete="off">
      <div class="relative">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-accent)] pointer-events-none">
          <circle cx="11" cy="11" r="8"/>
          <path stroke-linecap="round" d="m21 21-4.35-4.35"/>
        </svg>
        <input
          id="mobile-search-input"
          type="text"
          name="q"
          value={q}
          placeholder="Search Substash…"
          autocomplete="off"
          class="w-full h-9 pl-9 pr-4 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-3)] text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent)]/50 transition-colors"
        />
      </div>
    </form>
  </header>

  <SearchResults
    client:only="solid-js"
    initialQ={q}
    initialFilter={initialFilter}
    browseLinks={browseLinks}
    pageNameTags={pageNameTags}
    pageNamePerformers={pageNamePerformers}
    pageNameStudios={pageNameStudios}
  />

  <BottomNav slot="nav" />
</PageShell>

<script>
  function initMobileSearch() {
    if (location.pathname !== '/search') return;

    const q = new URLSearchParams(location.search).get('q');
    if (!q && window.innerWidth < 1024) {
      document.getElementById('mobile-search-input')?.focus();
    }

    const form = document.getElementById('mobile-search-form') as HTMLFormElement | null;
    form?.addEventListener('submit', () => {
      const filter = new URLSearchParams(location.search).get('filter');
      let hidden = form.querySelector<HTMLInputElement>('input[name="filter"]');
      if (filter && filter !== 'all') {
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'filter';
          form.appendChild(hidden);
        }
        hidden.value = filter;
      } else {
        hidden?.remove();
      }
    });
  }
  initMobileSearch();
  document.addEventListener('astro:page-load', initMobileSearch);
</script>
