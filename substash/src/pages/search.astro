---
import { DEMO_MODE } from "astro:env/server";
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import SearchResults from "@/components/search/SearchResults.solid";
import { db } from "@/lib/db";
import { settings } from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { formatOriginDisplay } from "@/lib/utils/subreddit";
import { getFeedSettings } from "@/lib/settings/feed";

function getSetting(key: string, fallback: string): string {
  return db.select().from(settings).where(eq(settings.key, key)).get()?.value ?? fallback;
}

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const initialFilter = Astro.url.searchParams.get("filter") ?? "all";
const r = Astro.url.searchParams.get("r")?.trim() ?? "";
const user = Astro.url.searchParams.get("user")?.trim() ?? "";
const rawSubreddit = user ? `u_${user}` : r;
const { showPrefix } = getFeedSettings();
const subDisplay = rawSubreddit
  ? formatOriginDisplay(rawSubreddit, rawSubreddit, showPrefix)
  : "";
const pageNameTags = getSetting("page_name_tags", "Tags");
const pageNamePerformers = getSetting("page_name_performers", DEMO_MODE ? "Authors" : "Creators");
const pageNameStudios = getSetting("page_name_studios", "Studios");

---

<PageShell title={rawSubreddit ? `${subDisplay} — Substash` : q ? `Search: ${q} — Substash` : "Substash: Search"}>
  {!rawSubreddit && (
    <header class="hidden lg:flex header-glass items-center gap-3">
      <button onclick="history.back()" aria-label="Go back" class="page-back text-[var(--color-text-muted)]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <h1 class="page-title truncate">{q ? `Results for “${q}”` : "Search"}</h1>
    </header>
  )}
  <!-- Mobile-only sticky header -->
  {rawSubreddit ? (
    <header class="lg:hidden header-glass sticky top-0 z-10 px-5 py-4 flex items-center gap-3">
      <button onclick="history.back()" aria-label="Go back" class="page-back text-[var(--color-text-muted)] shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/>
        </svg>
      </button>
      <p class="page-title text-sm font-semibold text-[var(--color-accent)] truncate">{subDisplay}</p>
    </header>
  ) : (
    <header class="lg:hidden header-glass sticky top-0 z-10 px-5 py-4 flex items-center gap-3">
      <button onclick="history.back()" aria-label="Go back" class="text-[var(--color-text-muted)] shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/>
        </svg>
      </button>
      <form id="mobile-search-form" action="/search" method="get" class="flex-1" autocomplete="off">
        <div class="relative">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-text-muted)] pointer-events-none">
            <circle cx="11" cy="11" r="8"/>
            <path stroke-linecap="round" d="m21 21-4.35-4.35"/>
          </svg>
          <input
            id="mobile-search-input"
            type="text"
            name="q"
            value={q}
            placeholder={`Search ${pageNameTags}, ${pageNamePerformers}, ${pageNameStudios}`}
            autocomplete="off"
            class="w-full h-9 pl-9 pr-4 rounded-control border border-[var(--color-border)] bg-[var(--color-surface-3)] text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent)]/50 transition-colors"
          />
        </div>
      </form>
    </header>
  )}

  <SearchResults
    client:only="solid-js"
    initialQ={q}
    initialFilter={initialFilter}
    pageNameTags={pageNameTags}
    pageNamePerformers={pageNamePerformers}
    pageNameStudios={pageNameStudios}
    initialSubreddit={rawSubreddit || undefined}
    initialSubredditDisplay={subDisplay || undefined}
  />

  <BottomNav slot="nav" />
</PageShell>

<script>
  function initMobileSearch() {
    if (location.pathname !== '/search') return;

    const q = new URLSearchParams(location.search).get('q');
    if (!q && window.innerWidth < 1024) {
      document.getElementById('mobile-search-input')?.focus();
    }

    const form = document.getElementById('mobile-search-form') as HTMLFormElement | null;
    form?.addEventListener('submit', () => {
      const filter = new URLSearchParams(location.search).get('filter');
      let hidden = form.querySelector<HTMLInputElement>('input[name="filter"]');
      if (filter && filter !== 'all') {
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'filter';
          form.appendChild(hidden);
        }
        hidden.value = filter;
      } else {
        hidden?.remove();
      }
    });
  }
  initMobileSearch();
  document.addEventListener('astro:page-load', initMobileSearch);
</script>
