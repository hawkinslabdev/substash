---
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import FeedContainer from "@/components/feed/FeedContainer.astro";
import FeedContent from "@/components/feed/FeedContent.astro";
import StashOffline from "@/components/ui/StashOffline.astro";
import { stashRequest } from "@/lib/stash/client";
import { FIND_SCENES, FIND_IMAGES } from "@/lib/stash/queries";
import { encodeCursor, nextCursor, type CursorPayload } from "@/lib/utils/cursor";
import { sceneToFeedItem, imageToFeedItem } from "@/lib/stash/feed-item";
import type { FeedItem } from "@/lib/stash/feed-item";
import type { FindScenesQuery, FindImagesQuery } from "@/lib/stash/types";
import { filterByTags } from "@/lib/stash/filter";
import { DEMO_MODE } from "astro:env/server";
import { demoFirstPage } from "@/lib/demo";
import SortBar from "@/components/ui/SortBar.astro";
import { cacheGet, cacheSet } from "@/lib/cache";

const ALLOWED_SORTS = ["date", "rating", "random"] as const;
type Sort = (typeof ALLOWED_SORTS)[number];

const rawSort =
  Astro.url.searchParams.get("sort") ??
  Astro.cookies.get("substash-sort")?.value ??
  "date";
const sort: Sort = (ALLOWED_SORTS as readonly string[]).includes(rawSort)
  ? (rawSort as Sort)
  : "date";

const seed = sort === "random" ? (Date.now() ^ (Math.random() * 2147483647)) : undefined;
const TYPES_PER_PAGE = 6;

interface FeedResult {
  items: FeedItem[];
  count: number;
  cursorPayload: CursorPayload;
  stashError: boolean;
}

async function fetchFeed(): Promise<FeedResult> {
  let items: FeedItem[] = [];
  let count = 0;
  let stashError = false;

  try {
    const [scenesData, imagesData] = await Promise.all([
      stashRequest<FindScenesQuery>(FIND_SCENES, {
        filter: {
          page: 1,
          per_page: TYPES_PER_PAGE,
          sort: sort === "date" ? "created_at" : sort === "rating" ? "o_counter" : sort,
          direction: sort !== "random" ? "DESC" : undefined,
        },
      }).catch((e) => {
        console.error("[home] scenes fetch failed:", e);
        stashError = true;
        return { findScenes: { count: 0, scenes: [] } };
      }),
      stashRequest<FindImagesQuery>(FIND_IMAGES, {
        filter: sort === "random"
          ? { page: 1, per_page: TYPES_PER_PAGE, sort: "random" }
          : sort === "rating"
            ? { page: 1, per_page: TYPES_PER_PAGE, sort: "o_counter", direction: "DESC" }
            : { page: 1, per_page: TYPES_PER_PAGE, sort: "created_at", direction: "DESC" },
      }).catch((e) => {
        console.error("[home] images fetch failed:", e);
        stashError = true;
        return { findImages: { count: 0, images: [] } };
      }),
    ]);

    const filteredScenes = filterByTags(scenesData.findScenes.scenes);
    const filteredImages = filterByTags(imagesData.findImages.images);

    const scenes = filteredScenes.map(sceneToFeedItem);
    const images = filteredImages.map(imageToFeedItem);

    const maxLen = Math.max(scenes.length, images.length);
    for (let i = 0; i < maxLen; i++) {
      if (i < scenes.length) items.push(scenes[i]);
      if (i < images.length) items.push(images[i]);
    }

    count = scenesData.findScenes.count + imagesData.findImages.count;
  } catch (e) {
    console.error("[home] unexpected feed error:", e);
    return { items: [], count: 0, cursorPayload: { page: 1, perPage: 20, total: 0, sort, seed }, stashError: false };
  }

  return {
    items,
    count,
    cursorPayload: { page: 1, perPage: 20, total: count, sort, seed },
    stashError,
  };
}

// Sync data from cache or DEMO_MODE — renders directly with no streaming.
// Otherwise start the fetch (NOT awaited) so Astro streams the shell first.
let syncResult: FeedResult | null = null;
let dataPromise: Promise<FeedResult> | null = null;
let demoSeed: number | undefined;

if (DEMO_MODE) {
  const demo = demoFirstPage(sort);
  syncResult = {
    items: demo.items,
    count: demo.count,
    cursorPayload: { page: 1, perPage: 20, total: demo.count, sort, seed: undefined },
    stashError: false,
  };
  demoSeed = demo.seed;
} else {
  const cacheKey = `feed:${sort}${seed !== undefined ? `:${seed}` : ''}`;
  syncResult = cacheGet<FeedResult>(cacheKey);
  if (!syncResult) {
    dataPromise = fetchFeed().then((result) => {
      cacheSet(cacheKey, result);
      return result;
    });
  }
}
---

<PageShell title="Substash: Home">
  <header class="sticky top-0 z-10 px-4 py-3 bg-[var(--color-surface)]/90 backdrop-blur border-b border-[var(--color-border)] flex items-center gap-3">
    <h1 class="text-base font-semibold">
      <img
        src="/logo.svg" alt="Substash logo" class="inline w-5 h-5 mr-1 -mt-0.5"
        />
      Substash
    </h1>
  </header>

  <SortBar sort={sort} baseUrl="/" variant="tabs" />

  {syncResult ? (
    <>
      {syncResult.items.length === 0 && !syncResult.stashError ? (
        <StashOffline />
      ) : (
        <FeedContainer
          initialItems={syncResult.items}
          initialCursor={encodeCursor(syncResult.cursorPayload)}
          initialNextCursor={nextCursor(syncResult.cursorPayload)}
          initialTotal={syncResult.count}
          sort={sort}
        />
      )}
      {syncResult.stashError && (
        <script is:inline>
          document.addEventListener("astro:page-load", () => {
            window.dispatchEvent(new CustomEvent("substash:toast", {
              detail: { message: "Couldn't reach Stash", duration: 5000, variant: "error" }
            }));
          }, { once: true });
        </script>
      )}
    </>
  ) : (
    <>
      <div id="feed-skeleton" class="p-4 space-y-4">
        <div class="skeleton-shimmer w-full rounded-xl" style="aspect-ratio: 16/9" />
        <div class="skeleton-shimmer h-4 w-2/3" />
        <div class="skeleton-shimmer h-3 w-1/3 opacity-60" />
        <div class="h-5" />
        <div class="skeleton-shimmer w-full rounded-xl" style="aspect-ratio: 16/9" />
        <div class="skeleton-shimmer h-4 w-3/5" />
        <div class="skeleton-shimmer h-3 w-1/3 opacity-60" />
        <div class="h-5" />
        <div class="skeleton-shimmer w-full rounded-xl" style="aspect-ratio: 4/3" />
        <div class="skeleton-shimmer h-4 w-1/2" />
        <div class="skeleton-shimmer h-3 w-1/3 opacity-60" />
      </div>
      <FeedContent dataPromise={dataPromise!} sort={sort} />
    </>
  )}

  <BottomNav slot="nav" />
</PageShell>

<script>
  document.addEventListener("astro:page-load", () => {
    if (location.pathname !== "/") return;
    const sort = new URL(location.href).searchParams.get("sort") ?? "date";
    document.cookie = `substash-sort=${sort}; path=/; max-age=31536000; SameSite=Strict`;
  });
</script>
