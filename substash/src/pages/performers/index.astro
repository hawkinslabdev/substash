---
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import PerformerGrid from "@/components/browse/PerformerGrid.astro";
import StashOffline from "@/components/ui/StashOffline.astro";
import { stashRequest } from "@/lib/stash/client";
import { FIND_PERFORMERS } from "@/lib/stash/queries";
import type { FindPerformersQuery } from "@/lib/stash/types";
import { DEMO_MODE } from "astro:env/server";
import { DEMO_PERFORMERS } from "@/lib/demo";
import { db } from "@/lib/db";
import { settings } from "@/lib/db/schema";
import { eq } from "drizzle-orm";

Astro.response.headers.set("Cache-Control", "public, max-age=300, stale-while-revalidate=3600");

const pageName = db.select().from(settings).where(eq(settings.key, "page_name_performers")).get()?.value ?? "Creators";

let performers: FindPerformersQuery["findPerformers"]["performers"] = [];
let offline = false;

if (DEMO_MODE) {
  performers = DEMO_PERFORMERS;
} else try {
  const data = await stashRequest<FindPerformersQuery>(FIND_PERFORMERS, {
    filter: { page: 1, per_page: 100, sort: "name" },
  });
  performers = data.findPerformers.performers;
} catch (err) {
  console.error("[browse] stashRequest failed:", err instanceof Error ? err.message : err);
  offline = true;
}
---

<PageShell title={`Substash: ${pageName}`}>
  <header class="header-glass sticky top-0 z-10 px-4 py-3">
    <h1 class="text-base font-semibold">
      <img
        src="/logo.svg" alt="Substash logo" class="inline w-5 h-5 mr-1 -mt-0.5"
        />
      {pageName}
    </h1>
  </header>
  {offline ? <StashOffline /> : <PerformerGrid performers={performers} />}
  <BottomNav slot="nav" />
</PageShell>
