---
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import FeedContainer from "@/components/feed/FeedContainer.astro";
import BlurHash from "@/components/ui/BlurHash.astro";
import StashOffline from "@/components/ui/StashOffline.astro";
import SortBar from "@/components/ui/SortBar.astro";
import { stashRequest } from "@/lib/stash/client";
import { FIND_PERFORMER, FIND_SCENES, FIND_IMAGES } from "@/lib/stash/queries";
import { proxyImage } from "@/lib/stash/image";
import { encodeCursor, nextCursor } from "@/lib/utils/cursor";
import { sceneToFeedItem, imageToFeedItem } from "@/lib/stash/feed-item";
import { attachCommentCounts } from "@/lib/db/comment-counts";
import type { FindPerformerQuery, FindScenesQuery, FindImagesQuery } from "@/lib/stash/types";
import { filterByTags } from "@/lib/stash/filter";
import { DEMO_MODE } from "astro:env/server";
import { demoItemsFiltered, getDemoPerformer } from "@/lib/demo";

const { slug } = Astro.params;
Astro.response.headers.set("Cache-Control", "public, max-age=60, stale-while-revalidate=600");
const TYPES_PER_PAGE = 10;

const ALLOWED_SORTS = ["date", "rating", "random"] as const;
type Sort = (typeof ALLOWED_SORTS)[number];

const rawSort = Astro.url.searchParams.get("sort") ?? "date";
const sort: Sort = (ALLOWED_SORTS as readonly string[]).includes(rawSort)
  ? (rawSort as Sort)
  : "date";

const sceneSort = sort === "date" ? "created_at" : sort === "rating" ? "o_counter" : sort;
const imageSort = sort === "date" ? "created_at" : sort === "rating" ? "o_counter" : sort;

let offline = false;
let performer: FindPerformerQuery["findPerformer"] = null;
let items: import("@/lib/stash/feed-item").FeedItem[] = [];
let count = 0;

if (DEMO_MODE) {
  performer = getDemoPerformer(slug!);
  if (performer) {
    const demo = demoItemsFiltered({ performerId: slug!, sort });
    items = demo.items;
    count = demo.count;
  }
} else try {
  const [performerData, scenesData, imagesData] = await Promise.all([
    stashRequest<FindPerformerQuery>(FIND_PERFORMER, { id: slug }),
    stashRequest<FindScenesQuery>(FIND_SCENES, {
      filter: {
        page: 1,
        per_page: TYPES_PER_PAGE,
        sort: sceneSort,
        direction: sort !== "random" ? "DESC" : undefined,
      },
      scene_filter: { performers: { value: [slug!], modifier: "INCLUDES" } },
    }),
    stashRequest<FindImagesQuery>(FIND_IMAGES, {
      filter: {
        page: 1,
        per_page: TYPES_PER_PAGE,
        sort: imageSort,
        direction: sort !== "random" ? "DESC" : undefined,
      },
      image_filter: { performers: { value: [slug!], modifier: "INCLUDES" } },
    }).catch((e) => { console.error("[performer] images fetch failed:", e); return { findImages: { count: 0, images: [] } }; }),
  ]);
  performer = performerData.findPerformer;

  const filteredScenes = filterByTags(scenesData.findScenes.scenes);
  const filteredImages = filterByTags(imagesData.findImages.images);

  const scenes = attachCommentCounts(filteredScenes.map(sceneToFeedItem));
  const images = attachCommentCounts(filteredImages.map(imageToFeedItem));

  const interleaved: typeof items = [];
  const maxLen = Math.max(scenes.length, images.length);
  for (let i = 0; i < maxLen; i++) {
    if (i < scenes.length) interleaved.push(scenes[i]);
    if (i < images.length) interleaved.push(images[i]);
  }

  items = interleaved;
  // count = unfiltered total from Stash — used for cursor/pagination
  count = scenesData.findScenes.count + imagesData.findImages.count;
} catch {
  offline = true;
}

const cursorPayload = { page: 1, perPage: 20, total: count, sort, performerId: slug };
const displayName = performer?.name ?? slug ?? "Performer";
---

<PageShell title={`Substash: ${displayName}`}>
  <header class="header-glass sticky top-0 z-10">
    <div class="flex items-center gap-3 px-4 py-3">
      <a href="/performers" class="text-[var(--color-text-muted)]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
        </svg>
      </a>
      {performer?.image_path && (
        <BlurHash
          src={proxyImage(performer.image_path!)}
          alt={displayName}
          width={32}
          height={32}
          class="w-8 h-8 rounded-full flex-shrink-0"
        />
      )}
      <h1 class="text-base font-semibold truncate">{displayName}</h1>
      <a
        href={`/discover?performer=${slug}`}
        aria-label="Play as feed"
        class="ml-auto -mr-2 flex items-center gap-1.5 min-h-11 px-2 text-[var(--color-text-muted)] hover:text-[var(--color-text)] shrink-0"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon stroke-linecap="round" stroke-linejoin="round" points="5 3 19 12 5 21 5 3" />
        </svg>
        <span class="text-xs">{count} items</span>
      </a>
    </div>
  </header>

  <SortBar sort={sort} baseUrl={`/performers/${slug}`} />

  {offline ? <StashOffline /> : items.length > 0 ? (
    <FeedContainer
      initialItems={items}
      initialCursor={encodeCursor(cursorPayload)}
      initialNextCursor={nextCursor(cursorPayload)}
      initialTotal={count}
      sort={sort}
      performerId={slug}
    />
  ) : (
    <div class="flex flex-col items-center justify-center py-16 gap-1 text-[var(--color-text-muted)]">
      <p class="text-sm">{count > 0 ? "Nothing to be seen here..." : "No content found..."}</p>
    </div>
  )}

  <BottomNav slot="nav" />
</PageShell>
