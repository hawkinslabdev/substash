---
import PageShell from "@/components/layout/PageShell.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import TagGrid from "@/components/browse/TagGrid.astro";
import StashOffline from "@/components/ui/StashOffline.astro";
import { stashRequest } from "@/lib/stash/client";
import { FIND_TAGS } from "@/lib/stash/queries";
import type { FindTagsQuery } from "@/lib/stash/types";
import { filterTagList } from "@/lib/stash/filter";
import { DEMO_MODE } from "astro:env/server";
import { DEMO_TAGS, DEMO_ITEMS } from "@/lib/demo";
import { getTagCovers, getDemoTagCovers, hasOwnImage } from "@/lib/search/tag-covers";
import { db } from "@/lib/db";
import { settings } from "@/lib/db/schema";
import { eq } from "drizzle-orm";

Astro.response.headers.set("Cache-Control", "public, max-age=300, stale-while-revalidate=3600");

const pageName = db.select().from(settings).where(eq(settings.key, "page_name_tags")).get()?.value ?? "Tags";

let tags: FindTagsQuery["findTags"]["tags"] = [];
let offline = false;

if (DEMO_MODE) {
  tags = DEMO_TAGS;
} else try {
  const data = await stashRequest<FindTagsQuery>(FIND_TAGS, {
    filter: { page: 1, per_page: 100, sort: "name" },
  });
  tags = filterTagList(data.findTags.tags);
} catch (err) {
  console.error("[browse] stashRequest failed:", err instanceof Error ? err.message : err);
  offline = true;
}

// Tags without their own image show their newest media instead of an empty box
const coverless = tags.filter((t) => !hasOwnImage(t.image_path)).map((t) => t.id);
if (coverless.length) {
  const covers = DEMO_MODE ? getDemoTagCovers(DEMO_ITEMS) : getTagCovers(coverless);
  tags = tags.map((t) => (covers.has(t.id) && !hasOwnImage(t.image_path) ? { ...t, image_path: covers.get(t.id)! } : t));
}
---

<PageShell title={`Substash: ${pageName}`}>
  <header class="header-glass sticky top-0 z-10 px-5 py-4 flex items-center gap-3">
    <button onclick="history.back()" aria-label="Go back" class="page-back hidden lg:flex text-[var(--color-text-muted)]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <h1 class="page-title text-base font-semibold">
      <img
        src="/logo.svg" alt="" class="inline lg:hidden w-5 h-5 mr-1 -mt-0.5"
        />
      {pageName}</h1>
  </header>
  {offline ? <StashOffline /> : <TagGrid tags={tags} />}
  <BottomNav slot="nav" />
</PageShell>
