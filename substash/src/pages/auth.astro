---
import "@/styles/global.css";
const from = Astro.url.searchParams.get("from") ?? "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0d0d" />
    <title>Substash: Unlock</title>
    <script is:inline>
      (function () {
        const accent = localStorage.getItem('substash:accent');
        if (accent) document.documentElement.setAttribute('data-accent', accent);
        const theme = localStorage.getItem('substash:theme');
        if (theme === 'oled') {
          document.documentElement.setAttribute('data-theme', 'oled');
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#000000');
        }
      })();
    </script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100dvh;
        background: var(--color-surface);
        color: var(--color-text);
        font-family: var(--font-sans);
        display: flex;
        overflow-x: hidden;
        overflow-y: auto;
        padding: max(28px, env(safe-area-inset-top)) 24px max(28px, env(safe-area-inset-bottom));
      }

      /* Two soft accent blooms — depth only, no media, nothing to leak pre-auth */
      body::before,
      body::after {
        content: "";
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
      }
      body::before {
        width: min(120vw, 900px);
        aspect-ratio: 1;
        top: -40vh;
        left: -30vw;
        background: radial-gradient(circle at center, color-mix(in srgb, var(--color-accent) 13%, transparent) 0%, transparent 68%);
      }
      body::after {
        width: min(90vw, 640px);
        aspect-ratio: 1;
        bottom: -28vh;
        right: -22vw;
        background: radial-gradient(circle at center, color-mix(in srgb, var(--color-accent) 8%, transparent) 0%, transparent 70%);
      }
      /* Pure black wants a quieter bloom — no shadows to carry it */
      :root[data-theme="oled"] body::before {
        background: radial-gradient(circle at center, color-mix(in srgb, var(--color-accent) 9%, transparent) 0%, transparent 68%);
      }
      :root[data-theme="oled"] body::after {
        background: radial-gradient(circle at center, color-mix(in srgb, var(--color-accent) 5%, transparent) 0%, transparent 70%);
      }

      /* margin:auto not justify-content — keeps the top reachable on short viewports */
      .shell {
        position: relative;
        z-index: 1;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
      }

      @keyframes rise-in {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .brand { animation: rise-in 520ms var(--ease-out-quart) backwards; }
      .entry { animation: rise-in 520ms 90ms var(--ease-out-quart) backwards; }

      .brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .logo {
        width: 60px;
        height: 60px;
        border-radius: 20px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
      }
      .logo img { width: 32px; height: 32px; display: block; }
      h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }
      p.sub {
        margin-top: 10px;
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        line-height: 1.5;
      }

      .entry {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* Six dots instead of six text inputs — no OS keyboard, nothing to shoulder-surf */
      .dots { display: flex; gap: 16px; }
      .dot {
        width: 13px;
        height: 13px;
        border-radius: 50%;
        border: 1.5px solid var(--color-border);
        transition:
          background-color 180ms var(--ease-out-quart),
          border-color 180ms var(--ease-out-quart),
          transform 180ms var(--ease-spring);
      }
      .dot.on {
        background: var(--color-accent);
        border-color: var(--color-accent);
        transform: scale(1.2);
      }
      .dots.ok .dot {
        background: var(--color-accent);
        border-color: var(--color-accent);
        transform: scale(1.2);
      }

      @keyframes pin-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-8px); }
        40% { transform: translateX(8px); }
        60% { transform: translateX(-5px); }
        80% { transform: translateX(5px); }
      }
      .dots.shake { animation: pin-shake 380ms var(--ease-out-quart); }

      .error {
        min-height: 1.25em;
        margin-top: 18px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: #f87171;
        text-align: center;
      }

      .pad {
        margin-top: 14px;
        display: grid;
        grid-template-columns: repeat(3, 74px);
        gap: 18px;
      }
      .key {
        width: 74px;
        height: 74px;
        border-radius: 50%;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        font-family: inherit;
        font-size: 1.5rem;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        transition:
          background-color 140ms ease,
          border-color 140ms ease,
          transform 90ms ease;
      }
      .key:hover {
        background: var(--color-surface-3);
        border-color: color-mix(in srgb, var(--color-accent) 32%, var(--color-border));
      }
      .key:active { transform: scale(0.92); }
      .key.ghost {
        background: transparent;
        border-color: transparent;
        color: var(--color-text-muted);
      }
      .key.ghost:hover {
        background: var(--color-surface-2);
        border-color: var(--color-border);
        color: var(--color-text);
      }
      .key.spacer { visibility: hidden; pointer-events: none; }
      .pad[data-busy] { pointer-events: none; opacity: 0.5; }

      :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

      /* Desktop: side-by-side so the identity carries the width instead of a lone column */
      @media (min-width: 900px) {
        .shell {
          flex-direction: row;
          align-items: center;
          gap: 88px;
        }
        .brand {
          align-items: flex-start;
          text-align: left;
        }
        h1 { font-size: 2.5rem; }
        p.sub { max-width: 30ch; }
      }

      @media (prefers-reduced-motion: reduce) {
        .brand, .entry { animation: none; }
        .dots.shake { animation: none; }
        .dot.on, .dots.ok .dot { transform: none; }
        .key:active { transform: none; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="brand">
        <div class="logo">
          <img src="/logo.svg" alt="" width="32" height="32" />
        </div>
        <h1>Welcome back</h1>
        <p class="sub">Enter your PIN to unlock Substash.</p>
      </section>

      <section class="entry">
        <div class="dots" id="dots" role="status" aria-live="polite" aria-label="No digits entered">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>

        <p class="error" id="error" role="alert"></p>

        <div class="pad" id="pad">
          <button class="key" type="button" data-digit="1" aria-label="1">1</button>
          <button class="key" type="button" data-digit="2" aria-label="2">2</button>
          <button class="key" type="button" data-digit="3" aria-label="3">3</button>
          <button class="key" type="button" data-digit="4" aria-label="4">4</button>
          <button class="key" type="button" data-digit="5" aria-label="5">5</button>
          <button class="key" type="button" data-digit="6" aria-label="6">6</button>
          <button class="key" type="button" data-digit="7" aria-label="7">7</button>
          <button class="key" type="button" data-digit="8" aria-label="8">8</button>
          <button class="key" type="button" data-digit="9" aria-label="9">9</button>
          <span class="key spacer" aria-hidden="true"></span>
          <button class="key" type="button" data-digit="0" aria-label="0">0</button>
          <button class="key ghost" type="button" data-action="back" aria-label="Delete last digit">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 5H9.5a2 2 0 0 0-1.5.7L3 12l5 6.3a2 2 0 0 0 1.5.7H20a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1z"/>
              <path stroke-linecap="round" d="m17 9-5 6m0-6 5 6"/>
            </svg>
          </button>
        </div>
      </section>
    </main>

    <script is:inline define:vars={{ from }}>
      const dotRow = document.getElementById('dots');
      const dotEls = Array.from(dotRow.querySelectorAll('.dot'));
      const pad = document.getElementById('pad');
      const err = document.getElementById('error');

      let pin = '';
      let busy = false;

      function render() {
        dotEls.forEach((d, i) => d.classList.toggle('on', i < pin.length));
        dotRow.setAttribute(
          'aria-label',
          pin.length === 0 ? 'No digits entered' : `${pin.length} of 6 digits entered`,
        );
      }

      function push(digit) {
        if (busy || pin.length >= 6) return;
        err.textContent = '';
        pin += digit;
        render();
        if (pin.length === 6) attempt();
      }

      function pop() {
        if (busy || !pin.length) return;
        err.textContent = '';
        pin = pin.slice(0, -1);
        render();
      }

      pad.addEventListener('click', (e) => {
        const key = e.target.closest('[data-digit], [data-action]');
        if (!key) return;
        if (key.dataset.action === 'back') pop();
        else push(key.dataset.digit);
      });

      // Physical keyboard stays first-class on desktop
      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (/^[0-9]$/.test(e.key)) { e.preventDefault(); push(e.key); }
        else if (e.key === 'Backspace') { e.preventDefault(); pop(); }
        else if (e.key === 'Escape') { e.preventDefault(); pin = ''; err.textContent = ''; render(); }
      });

      function fail(message) {
        err.textContent = message;
        dotRow.classList.remove('shake');
        void dotRow.offsetWidth; // restart the animation
        dotRow.classList.add('shake');
        navigator.vibrate?.([12, 40, 12]);
        pin = '';
        render();
      }

      async function attempt() {
        busy = true;
        pad.setAttribute('data-busy', '');
        err.textContent = '';
        try {
          const res = await fetch('/api/auth/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin }),
          });
          const data = await res.json();
          if (!res.ok) {
            fail(data.error === 'Invalid PIN' ? 'Incorrect PIN. Try again.' : data.error || 'Incorrect PIN. Try again.');
            busy = false;
            pad.removeAttribute('data-busy');
            return;
          }
          // Confirm before leaving — an instant redirect reads as a glitch
          dotRow.classList.add('ok');
          setTimeout(() => { window.location.href = from; }, 380);
        } catch {
          fail('Network error. Try again.');
          busy = false;
          pad.removeAttribute('data-busy');
        }
      }

      render();
    </script>
  </body>
</html>
