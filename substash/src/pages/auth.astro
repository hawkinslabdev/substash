---
import "@/styles/global.css";
const from = Astro.url.searchParams.get("from") ?? "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0d0d" />
    <title>Substash: Unlock</title>
    <script is:inline>
      (function () {
        const accent = localStorage.getItem('substash:accent');
        if (accent) document.documentElement.setAttribute('data-accent', accent);
        const theme = localStorage.getItem('substash:theme');
        if (theme === 'oled') {
          document.documentElement.setAttribute('data-theme', 'oled');
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#000000');
        }
      })();
    </script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100dvh;
        background: var(--color-surface);
        color: var(--color-text);
        font-family: var(--font-sans);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: max(24px, env(safe-area-inset-top)) 24px max(24px, env(safe-area-inset-bottom));
      }
      .card {
        width: 100%;
        max-width: 360px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 28px;
      }

      /* Staggered entrance — orients the user, runs once */
      @keyframes rise-in {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .card > * {
        animation: rise-in 480ms var(--ease-out-quart) backwards;
      }
      .card > :nth-child(2) { animation-delay: 60ms; }
      .card > :nth-child(3) { animation-delay: 120ms; }
      .card > :nth-child(4) { animation-delay: 160ms; }
      .card > :nth-child(5) { animation-delay: 200ms; }

      .logo {
        width: 64px;
        height: 64px;
        background: color-mix(in srgb, var(--color-accent) 16%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
        color: var(--color-accent);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      p.sub {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-align: center;
        line-height: 1.5;
      }
      .boxes {
        display: flex;
        gap: 10px;
      }
      .box {
        width: 46px;
        height: 56px;
        background: var(--color-surface-3);
        border: 1.5px solid var(--color-border);
        border-radius: 12px;
        font-size: 1.375rem;
        font-weight: 600;
        font-family: inherit;
        text-align: center;
        color: var(--color-text);
        caret-color: var(--color-accent);
        outline: none;
        transition: border-color 150ms ease, transform 150ms var(--ease-out-quart);
        text-transform: uppercase;
      }
      .box:focus {
        border-color: var(--color-accent);
        transform: scale(1.05);
      }
      .box.filled {
        border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
      }

      /* Wrong PIN: shake the row */
      @keyframes pin-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-7px); }
        40% { transform: translateX(7px); }
        60% { transform: translateX(-4px); }
        80% { transform: translateX(4px); }
      }
      .boxes.shake {
        animation: pin-shake 360ms var(--ease-out-quart);
      }

      .btn {
        width: 100%;
        height: 50px;
        background: var(--color-accent);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 0.9375rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: background 150ms ease, opacity 150ms ease, transform 80ms ease;
      }
      .btn:hover { background: var(--color-accent-hover); }
      .btn:active { transform: scale(0.97); }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
      .error {
        font-size: 0.8125rem;
        color: var(--color-accent);
        text-align: center;
        min-height: 1.2em;
      }

      @media (prefers-reduced-motion: reduce) {
        .card > * { animation: none; }
        .boxes.shake { animation: none; }
        .box:focus { transform: none; }
        .btn:active { transform: none; }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="logo">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <div style="text-align:center;display:flex;flex-direction:column;gap:8px">
        <h1>Welcome back</h1>
        <p class="sub">Enter your 6-digit PIN to unlock Substash.</p>
      </div>
      <div class="boxes" id="boxes">
        <input class="box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" data-index="0" aria-label="PIN digit 1" />
        <input class="box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" data-index="1" aria-label="PIN digit 2" />
        <input class="box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" data-index="2" aria-label="PIN digit 3" />
        <input class="box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" data-index="3" aria-label="PIN digit 4" />
        <input class="box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" data-index="4" aria-label="PIN digit 5" />
        <input class="box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" data-index="5" aria-label="PIN digit 6" />
      </div>
      <p class="error" id="error" aria-live="polite"></p>
      <button class="btn" id="btn" type="button">Unlock</button>
    </div>

    <script is:inline define:vars={{ from }}>
      const boxes = Array.from(document.querySelectorAll('.box'));
      const boxRow = document.getElementById('boxes');
      const btn = document.getElementById('btn');
      const err = document.getElementById('error');

      boxes[0].focus();

      function syncFilled() {
        boxes.forEach((b) => b.classList.toggle('filled', !!b.value));
      }

      boxes.forEach((box, i) => {
        box.addEventListener('input', (e) => {
          const val = e.target.value.replace(/[^0-9]/g, '').slice(-1);
          e.target.value = val;
          syncFilled();
          if (val && i < 5) boxes[i + 1].focus();
          if (i === 5 && val) attempt();
        });
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !e.target.value && i > 0) {
            boxes[i - 1].focus();
            boxes[i - 1].value = '';
            syncFilled();
          }
        });
        box.addEventListener('paste', (e) => {
          e.preventDefault();
          const text = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 6);
          text.split('').forEach((ch, j) => { if (boxes[j]) boxes[j].value = ch; });
          syncFilled();
          if (text.length === 6) attempt();
        });
      });

      btn.addEventListener('click', attempt);

      function fail(message) {
        err.textContent = message;
        boxRow.classList.remove('shake');
        void boxRow.offsetWidth; // restart the animation
        boxRow.classList.add('shake');
        navigator.vibrate?.([12, 40, 12]);
      }

      async function attempt() {
        const pin = boxes.map(b => b.value).join('');
        if (pin.length < 6) { fail('Enter all 6 digits.'); return; }
        btn.disabled = true;
        err.textContent = '';
        try {
          const res = await fetch('/api/auth/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin }),
          });
          const data = await res.json();
          if (!res.ok) {
            fail(data.error || 'Incorrect PIN.');
            boxes.forEach(b => b.value = '');
            syncFilled();
            boxes[0].focus();
            btn.disabled = false;
            return;
          }
          window.location.href = from;
        } catch {
          fail('Network error. Try again.');
          btn.disabled = false;
        }
      }
    </script>
  </body>
</html>
