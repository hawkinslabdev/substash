---
import Feed from "./Feed.solid";
import type { FeedItem } from "@/lib/stash/feed-item";

interface Props {
  initialItems: FeedItem[];
  initialCursor: string;
  initialNextCursor: string | null;
  initialTotal: number;
  sort?: string;
  tagId?: string;
  studioId?: string;
  performerId?: string;
}

const {
  initialItems,
  initialCursor,
  initialNextCursor,
  initialTotal,
  sort,
  tagId,
  studioId,
  performerId,
} = Astro.props;
---

<div data-feed-skeleton class="p-4 space-y-4" aria-hidden="true">
  <div class="skeleton-shimmer w-full rounded-xl" style="aspect-ratio: 16/9" />
  <div class="skeleton-shimmer h-4 w-2/3" />
  <div class="skeleton-shimmer h-3 w-1/3 opacity-60" />
  <div class="h-5" />
  <div class="skeleton-shimmer w-full rounded-xl" style="aspect-ratio: 16/9" />
  <div class="skeleton-shimmer h-4 w-3/5" />
  <div class="skeleton-shimmer h-3 w-1/3 opacity-60" />
</div>

<Feed
  client:only="solid-js"
  sort={sort}
  tagId={tagId}
  studioId={studioId}
  performerId={performerId}
  initialData={{
    items: initialItems,
    cursor: initialCursor,
    nextCursor: initialNextCursor,
    total: initialTotal,
  }}
/>
