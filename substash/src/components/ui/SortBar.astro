---
interface SortOption {
  key: string;
  label: string;
}

interface Props {
  sort: string;
  baseUrl: string;
  sorts?: SortOption[];
  variant?: "tabs" | "dropdown";
}

const DEFAULT_SORTS: SortOption[] = [
  { key: "date", label: "Recent" },
  { key: "rating", label: "Top" },
  { key: "random", label: "Random" },
];

const { sort, baseUrl, sorts = DEFAULT_SORTS, variant = "dropdown" } = Astro.props;
const currentLabel = sorts.find((s) => s.key === sort)?.label ?? sort;
---

{variant === "tabs" ? (
  <div class="flex items-center gap-2 px-4 py-2.5 border-b border-[var(--color-border)] bg-[var(--color-surface)] overflow-x-auto scrollbar-none">
    {sorts.map((s) => (
      <a
        href={`${baseUrl}?sort=${s.key}`}
        class:list={[
          "flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-semibold whitespace-nowrap shrink-0 transition-all active:scale-95",
          s.key === sort
            ? "bg-[var(--color-accent)] text-white shadow-sm"
            : "bg-[var(--color-surface-2)] text-[var(--color-text-muted)] hover:text-[var(--color-text)]",
        ]}
        aria-current={s.key === sort ? "page" : undefined}
      >
        {s.key === "date" && (
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" />
          </svg>
        )}
        {s.key === "rating" && (
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5z" />
          </svg>
        )}
        {s.key === "random" && (
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
        )}
        {s.label}
      </a>
    ))}
  </div>
) : (
  <div class="sort-bar px-3 py-2 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <details class="sort-dropdown relative inline-block">
      <summary class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] active:scale-95 text-sm font-medium cursor-pointer select-none transition-all list-none">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent)] shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M7 12h10M11 18h2" />
        </svg>
        <span>Sort: <span class="text-[var(--color-text)]">{currentLabel}</span></span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="sort-chevron text-[var(--color-text-muted)] shrink-0 transition-transform">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
        </svg>
      </summary>

      <div class="sort-menu absolute top-full left-0 mt-1.5 z-40 min-w-[160px] rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-2)] shadow-2xl overflow-hidden">
        {sorts.map((s) => (
          <a
            href={`${baseUrl}?sort=${s.key}`}
            class:list={[
              "flex items-center justify-between px-4 py-3 text-sm transition-colors",
              s.key === sort
                ? "text-[var(--color-text)] bg-[var(--color-surface-3)] font-semibold"
                : "text-[var(--color-text-muted)] hover:bg-[var(--color-surface-3)] hover:text-[var(--color-text)]",
            ]}
          >
            {s.label}
            {s.key === sort && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-accent)]">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </details>
  </div>
)}

<style>
  .sort-dropdown[open] .sort-chevron {
    transform: rotate(180deg);
  }

  .sort-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".sort-dropdown[open]").forEach((el) => {
      if (!el.contains(e.target as Node)) el.removeAttribute("open");
    });
  });
</script>
