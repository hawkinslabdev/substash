---
interface SortOption {
  key: string;
  label: string;
}

interface Props {
  sort: string;
  baseUrl: string;
  sorts?: SortOption[];
  variant?: "tabs" | "dropdown";
}

const DEFAULT_SORTS: SortOption[] = [
  { key: "date", label: "Recent" },
  { key: "rating", label: "Top" },
  { key: "random", label: "Random" },
];

const { sort, baseUrl, sorts = DEFAULT_SORTS, variant = "dropdown" } = Astro.props;
const currentLabel = sorts.find((s) => s.key === sort)?.label ?? sort;
---

{variant === "tabs" ? (
  <nav aria-label="Sort" class="flex items-center gap-6 px-5 border-b border-[var(--color-border)] bg-[var(--color-surface)] overflow-x-auto scrollbar-none">
    {sorts.map((s) => (
      <a
        href={`${baseUrl}?sort=${s.key}`}
        class:list={[
          "relative flex items-center h-12 text-sm font-semibold whitespace-nowrap shrink-0 transition-colors",
          "after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:rounded-full",
          s.key === sort
            ? "text-[var(--color-text)] after:bg-[var(--color-accent)]"
            : "text-[var(--color-text-muted)] hover:text-[var(--color-text)]",
        ]}
        aria-current={s.key === sort ? "page" : undefined}
      >
        {s.label}
      </a>
    ))}
    <button
      type="button"
      data-density-toggle
      aria-pressed="false"
      aria-label="Compact view"
      title="Compact view"
      class="density-toggle ml-auto shrink-0 flex items-center justify-center w-10 h-10 rounded-control text-[var(--color-text-muted)] hover:bg-[var(--color-surface-3)] hover:text-[var(--color-text)] transition-colors"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="4" width="7" height="6" rx="1.5" /><path stroke-linecap="round" d="M14 6h7M14 9h4" />
        <rect x="3" y="14" width="7" height="6" rx="1.5" /><path stroke-linecap="round" d="M14 16h7M14 19h4" />
      </svg>
    </button>
  </nav>
) : (
  <div class="sort-bar flex items-center px-3 py-2 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <details class="sort-dropdown relative inline-block">
      <summary class="flex items-center gap-1.5 px-3 py-1.5 rounded-control bg-[var(--color-surface-2)] hover:bg-[var(--color-surface-3)] active:scale-95 text-sm font-medium cursor-pointer select-none transition-all list-none">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent)] shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M7 12h10M11 18h2" />
        </svg>
        <span>Sort: <span class="text-[var(--color-text)]">{currentLabel}</span></span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="sort-chevron text-[var(--color-text-muted)] shrink-0 transition-transform">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
        </svg>
      </summary>

      <div class="sort-menu absolute top-full left-0 mt-1.5 z-40 min-w-[160px] rounded-control border border-[var(--color-border)] bg-[var(--color-surface-2)] shadow-2xl overflow-hidden">
        {sorts.map((s) => (
          <a
            href={`${baseUrl}?sort=${s.key}`}
            class:list={[
              "flex items-center justify-between px-4 py-3 text-sm transition-colors",
              s.key === sort
                ? "text-[var(--color-text)] bg-[var(--color-surface-3)] font-semibold"
                : "text-[var(--color-text-muted)] hover:bg-[var(--color-surface-3)] hover:text-[var(--color-text)]",
            ]}
          >
            {s.label}
            {s.key === sort && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-accent)]">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </details>
    <button
      type="button"
      data-density-toggle
      aria-pressed="false"
      aria-label="Compact view"
      title="Compact view"
      class="density-toggle ml-auto shrink-0 flex items-center justify-center w-10 h-10 rounded-control text-[var(--color-text-muted)] hover:bg-[var(--color-surface-3)] hover:text-[var(--color-text)] transition-colors"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="4" width="7" height="6" rx="1.5" /><path stroke-linecap="round" d="M14 6h7M14 9h4" />
        <rect x="3" y="14" width="7" height="6" rx="1.5" /><path stroke-linecap="round" d="M14 16h7M14 19h4" />
      </svg>
    </button>
  </div>
)}

<style>
  .sort-dropdown[open] .sort-chevron {
    transform: rotate(180deg);
  }

  .sort-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .density-toggle[aria-pressed="true"] {
    color: var(--color-text);
    background: var(--color-surface-3);
  }

  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const DENSITY_KEY = "substash:density";

  function syncDensityToggles() {
    const compact = document.documentElement.dataset.feedDensity === "compact";
    document.querySelectorAll("[data-density-toggle]").forEach((b) => b.setAttribute("aria-pressed", String(compact)));
  }

  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest("[data-density-toggle]")) return;
    const compact = document.documentElement.dataset.feedDensity !== "compact";
    if (compact) document.documentElement.dataset.feedDensity = "compact";
    else delete document.documentElement.dataset.feedDensity;
    try {
      localStorage.setItem(DENSITY_KEY, compact ? "compact" : "card");
    } catch {}
    syncDensityToggles();
  });
  document.addEventListener("astro:page-load", syncDensityToggles);
  syncDensityToggles();

  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".sort-dropdown[open]").forEach((el) => {
      if (!el.contains(e.target as Node)) el.removeAttribute("open");
    });
  });
</script>
