---
import BlurHash from "@/components/ui/BlurHash.astro";
import { formatCount } from "@/lib/utils/format";
import { proxyImage } from "@/lib/stash/image";
import type { StashPerformer } from "@/lib/stash/types";

interface Props {
  performers: StashPerformer[];
}
const { performers } = Astro.props;
---

{performers.length === 0 && (
  <div class="flex flex-col items-center justify-center min-h-[50dvh] gap-3 px-6 text-center">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-text-muted)]">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>
    <div class="space-y-1">
      <p class="text-sm font-semibold text-[var(--color-text)]">No creators yet</p>
      <p class="text-xs text-[var(--color-text-muted)] max-w-[240px] leading-relaxed">
        Add performer info in Stash and they'll show up here automatically.
      </p>
    </div>
  </div>
)}

<ul class="grid grid-cols-3 gap-3 p-4 sm:grid-cols-4 md:grid-cols-5">
  {
    performers.map((performer) => (
      <li>
        <a
          href={`/performers/${performer.id}`}
          class="performer-link flex flex-col items-center gap-1.5 active:scale-95 transition-all group"
        >
          <div class="performer-ring w-full">
            <BlurHash
              src={proxyImage(performer.image_path)}
              alt={performer.name}
              width={120}
              height={120}
              class="performer-avatar w-full aspect-square rounded-full object-cover block"
            />
          </div>
          <p class="text-xs text-center truncate w-full px-1 group-hover:text-[var(--color-text)] transition-colors">{performer.name}</p>
          {(performer.scene_count != null || performer.image_count != null) && (
            <p class="text-xs text-[var(--color-text-muted)]">
              {formatCount((performer.scene_count ?? 0) + (performer.image_count ?? 0))}
            </p>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .performer-ring {
    position: relative;
    border-radius: 9999px;
    padding: 2px;
    aspect-ratio: 1 / 1;
    background: var(--color-border);
    transition: box-shadow 200ms ease;
  }

  .performer-ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(to bottom, rgba(255, 69, 0, 0.08) 0%, rgba(255, 69, 0, 0.35) 100%);
    z-index: 1;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .performer-link:hover .performer-ring::after,
  .performer-link:focus-visible .performer-ring::after {
    opacity: 1;
  }

  .performer-link:hover .performer-ring {
    box-shadow: 0 8px 24px -4px rgba(255, 69, 0, 0.55);
  }

  .performer-avatar {
    position: relative;
    z-index: 2;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .performer-ring,
    .performer-ring::after {
      transition: none;
    }
  }
</style>
