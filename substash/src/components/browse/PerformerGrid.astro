---
import BlurHash from "@/components/ui/BlurHash.astro";
import { formatCount } from "@/lib/utils/format";
import { proxyImage } from "@/lib/stash/image";
import type { StashPerformer } from "@/lib/stash/types";

interface Props {
  performers: StashPerformer[];
}
const { performers } = Astro.props;
---

{performers.length === 0 && (
  <div class="flex flex-col items-center justify-center min-h-[50dvh] gap-3 px-6 text-center">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-text-muted)]">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>
    <div class="space-y-1">
      <p class="text-sm font-semibold text-[var(--color-text)]">No stars yet</p>
      <p class="text-xs text-[var(--color-text-muted)] max-w-[240px] leading-relaxed">
        Add performer info in Stash and they'll show up here automatically.
      </p>
    </div>
  </div>
)}

<ul class="grid grid-cols-3 gap-3 p-4 sm:grid-cols-4 md:grid-cols-5">
  {
    performers.map((performer) => (
      <li>
        <a
          href={`/performers/${performer.id}`}
          class="flex flex-col items-center gap-1.5 active:scale-95 transition-transform"
        >
          <BlurHash
            src={proxyImage(performer.image_path)}
            alt={performer.name}
            width={120}
            height={120}
            class="w-full aspect-square rounded-full object-cover border-2 border-[var(--color-border)]"
          />
          <p class="text-xs text-center truncate w-full px-1">{performer.name}</p>
          {(performer.scene_count != null || performer.image_count != null) && (
            <p class="text-[10px] text-[var(--color-text-muted)]">
              {formatCount((performer.scene_count ?? 0) + (performer.image_count ?? 0))}
            </p>
          )}
        </a>
      </li>
    ))
  }
</ul>
