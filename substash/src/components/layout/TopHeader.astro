---
import { DEMO_MODE } from "astro:env/server";
import { db } from "@/lib/db";
import { settings } from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { getAppName } from "@/lib/settings/app-name";

function getSetting(key: string, fallback: string): string {
  return db.select().from(settings).where(eq(settings.key, key)).get()?.value ?? fallback;
}

const appName = getAppName();
// Same user-renamable labels as the sidebar (Settings → page names)
const searchPlaceholder = `Search ${getSetting("page_name_tags", "Tags")}, ${getSetting("page_name_performers", DEMO_MODE ? "Authors" : "Creators")}, ${getSetting("page_name_studios", "Studios")}`;
---

<header class="top-header hidden lg:flex fixed top-0 left-0 right-0 z-50 items-center gap-8 px-6 bg-[var(--color-surface-2)] border-b border-[var(--color-border)]">
  <div class="flex items-center gap-3 shrink-0">
  <!-- Collapse state is wired by initSidebar in BottomNav.astro -->
  <button
    id="sidebar-toggle"
    type="button"
    aria-controls="sidebar"
    aria-label="Toggle sidebar"
    title="Toggle sidebar"
    class="flex items-center justify-center w-10 h-10 -ml-2 rounded-control text-[var(--color-text-muted)] hover:bg-[var(--color-surface-3)] hover:text-[var(--color-text)] transition-colors"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
  <a
    href="/"
    class="flex items-center gap-2.5 shrink-0 transition-opacity hover:opacity-80 active:opacity-60"
  >
    <img src="/logo.svg" alt="" class="w-6 h-6" />
    <span class="text-[15px] font-semibold tracking-tight text-[var(--color-text)]">{appName}</span>
  </a>
  </div>

  <!-- Search navigates only on submit with a non-empty query -->
  <form
    id="header-search-form"
    action="/search"
    method="get"
    role="search"
    class="flex-1 max-w-[560px] mx-auto"
    autocomplete="off"
  >
    <label class="relative flex items-center">
      <span class="sr-only">Search</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        class="absolute left-3.5 text-[var(--color-text-muted)] pointer-events-none"
      >
        <circle cx="11" cy="11" r="8"/>
        <path stroke-linecap="round" d="m21 21-4.35-4.35"/>
      </svg>
      <input
        type="search"
        name="q"
        placeholder={searchPlaceholder}
        class="w-full h-10 pl-10 pr-4 rounded-control border border-transparent bg-[var(--color-surface-3)] text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-border)] focus:bg-[var(--color-surface)] transition-colors"
      />
    </label>
  </form>
</header>

<style>
  .top-header {
    height: var(--header-height);
  }
</style>

<script>
  function initSearch() {
    const form = document.getElementById('header-search-form') as HTMLFormElement | null;

    // Sync input value with current search query when on /search page
    const input = form?.querySelector<HTMLInputElement>('input[name="q"]');
    if (input) {
      input.value = location.pathname === '/search'
        ? (new URLSearchParams(location.search).get('q') ?? '')
        : '';
    }

    form?.addEventListener('submit', (e) => {
      const inp = (e.currentTarget as HTMLFormElement).querySelector<HTMLInputElement>('input[name="q"]');
      if (!inp?.value.trim()) { e.preventDefault(); return; }

      // Carry active filter tab forward when re-searching on /search
      if (location.pathname === '/search') {
        const filter = new URLSearchParams(location.search).get('filter');
        let hidden = form.querySelector<HTMLInputElement>('input[name="filter"]');
        if (filter && filter !== 'all') {
          if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'filter';
            form.appendChild(hidden);
          }
          hidden.value = filter;
        } else {
          hidden?.remove();
        }
      }
    });
  }
  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>
