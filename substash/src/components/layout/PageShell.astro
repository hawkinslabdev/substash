---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Toast from "@/components/ui/Toast.solid";
import TopHeader from "@/components/layout/TopHeader.astro";

interface Props {
  title?: string;
  description?: string;
  /** Preload the next video/image for sub-pages */
  preloadUrl?: string;
  preloadAs?: "video" | "image";
}

const {
  title = "Substash",
  description = "Your personal media feed",
  preloadUrl,
  preloadAs,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="description" content={description} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    {preloadUrl && <link rel="preload" href={preloadUrl} as={preloadAs ?? "video"} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="preload" href="https://rsms.me/inter/inter.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://rsms.me/inter/inter.css" /></noscript>
    <ClientRouter />
    <!-- Anti-flash: sidebar collapse state + take over scroll restoration -->
    <script is:inline>
      (function () {
        // Sidebar collapse
        if (localStorage.getItem('substash:sidebar') === 'collapsed') {
          document.documentElement.style.setProperty('--sidebar-width-desktop', '64px');
          document.documentElement.setAttribute('data-sidebar-collapsed', '');
        }
        // Hand scroll restoration to our own code so Astro doesn't race us
        history.scrollRestoration = 'manual';
      })();
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
    <script>
      // Scroll save/restore for Astro ClientRouter SPA navigation.
      //
      // WHY astro:after-swap and not astro:page-load:
      //   after-swap fires inside startViewTransition() — before the animation
      //   runs. Scrolling here means the view-transition snapshot captures the
      //   correct position, so the user never sees a flash at y=0 on back-nav.
      //
      // WHY min-height:
      //   client:only islands (Feed) hydrate asynchronously — the page is short
      //   at after-swap time. We temporarily stretch the body so scrollTo(y)
      //   isn't clamped, then remove it once real content fills the page.

      const SCROLL_KEY = (url: string) => `substash:scroll:${url}`;
      let pendingRestore: number | null = null;
      let cancelScrollRestore: (() => void) | null = null;

      document.addEventListener('astro:before-preparation', (e) => {
        cancelScrollRestore?.();
        cancelScrollRestore = null;

        document.querySelectorAll('link[rel="preload"]').forEach((l) => l.remove());

        try {
          sessionStorage.setItem(SCROLL_KEY(location.href), String(Math.round(window.scrollY)));
        } catch { /* quota */ }

        const ev = e as TransitionBeforePreparationEvent;
        // Expose nav type so Feed islands can detect back-nav without depending
        // on astro:after-swap timing (which fires before client:only hydration).
        try { sessionStorage.setItem('substash:last-nav-type', ev.navigationType); } catch {}

        if (ev.navigationType === 'traverse') {
          try {
            const raw = sessionStorage.getItem(SCROLL_KEY(ev.to.href));
            const y = raw !== null ? parseInt(raw, 10) : 0;
            pendingRestore = Number.isFinite(y) && y > 0 ? y : null;
          } catch {
            pendingRestore = null;
          }
        } else {
          pendingRestore = null;
        }
      });

      document.addEventListener('astro:after-swap', () => {
        const targetY = pendingRestore;

        if (!targetY) {
          window.scrollTo({ top: 0, behavior: 'instant' });
          return;
        }

        // Stretch body so scrollTo(targetY) isn't clamped while the island is loading.
        const minH = targetY + window.innerHeight + 100;
        document.body.style.minHeight = `${minH}px`;
        // Force synchronous reflow so the minHeight applies before scrollTo.
        // Without this, the browser uses stale layout (~500px) and clamps scroll to 0.
        void document.body.offsetHeight;
        window.scrollTo({ top: targetY, behavior: 'instant' });

        let cleaned = false;
        let ro: ResizeObserver | null = null;
        let timer: ReturnType<typeof setTimeout> | null = null;

        function cleanup() {
          if (cleaned) return;
          cleaned = true;
          document.body.style.minHeight = '';
          ro?.disconnect();
          if (timer !== null) clearTimeout(timer);
        }

        // Once real content (Feed island) surpasses the synthetic height, remove it
        // and re-scroll defensively — handles the rare case where the initial
        // scrollTo was still clamped despite the forced reflow.
        ro = new ResizeObserver(() => {
          if (!cleaned && document.documentElement.scrollHeight > minH) {
            cleanup();
            window.scrollTo({ top: targetY, behavior: 'instant' });
          }
        });
        ro.observe(document.body);

        timer = setTimeout(() => {
          cleanup();
          window.scrollTo({ top: targetY, behavior: 'instant' });
        }, 5000);
        cancelScrollRestore = cleanup;
      });

      document.addEventListener('astro:page-load', () => {
        // Handles initial hard load (no after-swap fired).
        // SPA push navs: after-swap already scrolled to 0; another call is harmless.
        // SPA traverse navs: pendingRestore is set, skip so after-swap's scroll stands.
        if (pendingRestore === null) {
          window.scrollTo({ top: 0, behavior: 'instant' });
        }
        pendingRestore = null;
      });
    </script>
  </head>
  <body>
    <TopHeader />
    <main transition:animate="fade">
      <div class="lg:max-w-[720px] lg:mx-auto">
        <slot />
      </div>
    </main>
    <slot name="nav" />
    <Toast client:load />
  </body>
</html>
