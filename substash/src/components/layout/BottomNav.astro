---
import { DEMO_MODE } from "astro:env/server";

const navSections = [
  {
    category: "FEED",
    links: [
      {
        href: "/",
        label: "Home",
        svg: `<path stroke-linecap="round" stroke-linejoin="round" d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline stroke-linecap="round" stroke-linejoin="round" points="9 22 9 12 15 12 15 22"/>`,
      },
      {
        href: "/discover",
        label: "Discover",
        svg: `<circle cx="12" cy="12" r="10"/><polygon stroke-linecap="round" stroke-linejoin="round" points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`,
      },
    ],
  },
  {
    category: "BROWSE",
    links: [
      {
        href: "/tags",
        label: "Tags",
        svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line stroke-linecap="round" x1="7" y1="7" x2="7.01" y2="7"/>`,
      },
      {
        href: "/performers",
        label: DEMO_MODE ? "Authors" : "Stars",
        svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`,
      },
      {
        href: "/studios",
        label: "Studios",
        svg: `<rect x="2" y="3" width="20" height="14" rx="2"/><path stroke-linecap="round" d="M8 21h8M12 17v4"/>`,
      },
    ],
  },
  {
    category: "RECENT",
    links: [
      {
        href: "/activity/likes",
        label: "Likes",
        svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
      },
      {
        href: "/activity/comments",
        label: "Comments",
        svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
      },
    ],
  },
  {
    category: "SETTINGS",
    links: [
      {
        href: "/settings",
        label: "Settings",
        svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>`,
      },
    ],
  },
];

const mobileLinks = [
  navSections[0].links[0], // Home
  navSections[0].links[1], // Discover
  navSections[1].links[0], // Tags
  navSections[1].links[1], // Stars
];

const drawerLinks = [
  navSections[1].links[2], // Studios
  navSections[2].links[0], // Likes
  navSections[2].links[1], // Comments
];
---

<nav
  id="sidebar"
  class="nav-rail fixed bottom-0 left-0 right-0 z-50
    flex items-center justify-around
    bg-[var(--color-surface-2)]
    border-t border-[var(--color-border)]
    lg:right-auto lg:bottom-0
    lg:flex-col lg:justify-between lg:items-stretch
    lg:border-t-0 lg:border-r lg:border-[var(--color-border)]
    lg:bg-[var(--color-surface-2)]"
>

  <!-- Desktop: categorized sidebar nav -->
  <div class="hidden lg:flex flex-col flex-1 overflow-y-auto overflow-x-hidden py-4 gap-5">
    {navSections.map(({ category, links }) => (
      <div>
        <p class="nav-category px-4 mb-1.5 text-[10px] font-bold tracking-widest text-[var(--color-text-muted)] uppercase select-none whitespace-nowrap overflow-hidden">
          {category}
        </p>
        <div class="px-3 space-y-0.5">
          {links.map(({ href, label, svg }) => (
            <a
              href={href}
              class="nav-desktop-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors whitespace-nowrap"
              title={label}
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                class="shrink-0"
                set:html={svg}
              />
              <span class="nav-label">{label}</span>
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- Log off (desktop sidebar — pushed to bottom) -->
    <div class="mt-auto px-3">
      <button
        data-logout-trigger
        class="nav-logout-btn flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors whitespace-nowrap w-full text-left"
        title="Log off"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          class="shrink-0"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline stroke-linecap="round" stroke-linejoin="round" points="16 17 21 12 16 7"/>
          <line stroke-linecap="round" x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        <span class="nav-label">Log off</span>
      </button>
    </div>
  </div>

  <!-- Desktop: collapse toggle -->
  <button
    id="sidebar-toggle"
    class="hidden lg:flex items-center justify-center w-full h-10 shrink-0
      border-t border-[var(--color-border)]
      text-[var(--color-text-muted)] hover:text-[var(--color-text)]
      hover:bg-[var(--color-surface-3)] transition-colors"
    aria-label="Toggle sidebar"
    title="Toggle sidebar"
  >
    <svg
      id="toggle-icon"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      style="transition: transform 250ms ease"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6"/>
    </svg>
  </button>

  <!-- Mobile: bottom tab bar (4 core links + hamburger) -->
  <div class="flex lg:hidden flex-1 items-center justify-around h-full">
    {mobileLinks.map(({ href, label, svg }) => (
      <a
        href={href}
        class="nav-mobile-link flex items-center justify-center flex-1 h-full transition-colors"
      >
        <span class="nav-mobile-pill flex flex-col items-center gap-0.5 px-4 py-1.5 rounded-full transition-colors">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            set:html={svg}
          />
          <span class="text-[10px] leading-none">{label}</span>
        </span>
      </a>
    ))}

    <!-- Hamburger -->
    <button
      id="mobile-menu-trigger"
      aria-label="More options"
      aria-expanded="false"
      class="nav-mobile-link flex items-center justify-center flex-1 h-full transition-colors"
    >
      <span class="nav-mobile-pill flex flex-col items-center gap-0.5 px-4 py-1.5 rounded-full transition-colors">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
        >
          <line stroke-linecap="round" x1="3" y1="6" x2="21" y2="6"/>
          <line stroke-linecap="round" x1="3" y1="12" x2="21" y2="12"/>
          <line stroke-linecap="round" x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <span class="text-[10px] leading-none">More</span>
      </span>
    </button>
  </div>
</nav>

<!-- ── Mobile drawer backdrop ── -->
<div
  id="mobile-drawer-backdrop"
  class="lg:hidden fixed inset-0 z-[60] bg-black/60 opacity-0 pointer-events-none"
  style="transition: opacity 220ms ease"
></div>

<!-- ── Mobile drawer ── -->
<div
  id="mobile-drawer"
  class="lg:hidden fixed bottom-0 inset-x-0 z-[70] translate-y-full bg-[var(--color-surface-2)] border-t border-[var(--color-border)] rounded-t-2xl"
  style="transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1); padding-bottom: env(safe-area-inset-bottom)"
>
  <!-- Drag handle -->
  <div class="flex justify-center pt-3 pb-2">
    <div class="w-10 h-1 rounded-full bg-[var(--color-border)]"></div>
  </div>

  <!-- Drawer nav links -->
  <div class="px-3 pb-3 space-y-0.5">
    {drawerLinks.map(({ href, label, svg }) => (
      <a
        href={href}
        class="drawer-link flex items-center gap-3 px-3 py-3 rounded-xl text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-3)] active:scale-[0.98] transition-all"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          class="shrink-0"
          set:html={svg}
        />
        {label}
      </a>
    ))}

    <!-- Divider -->
    <div class="h-px bg-[var(--color-border)] mx-1 my-2"></div>

    <!-- Log off (mobile drawer) -->
    <button
      data-logout-trigger
      class="flex items-center gap-3 px-3 py-3 rounded-xl text-sm font-medium w-full text-left text-red-400 hover:bg-red-950/30 active:scale-[0.98] transition-all"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="shrink-0"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline stroke-linecap="round" stroke-linejoin="round" points="16 17 21 12 16 7"/>
        <line stroke-linecap="round" x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      Log off
    </button>
  </div>
</div>

<!-- ── Logout confirmation modal ── -->
<div
  id="logout-modal"
  class="fixed inset-0 z-[80] flex items-center justify-center opacity-0 pointer-events-none"
  style="transition: opacity 200ms ease"
  role="dialog"
  aria-modal="true"
  aria-labelledby="logout-modal-title"
>
  <div
    id="logout-modal-backdrop"
    class="absolute inset-0 bg-black/70"
  ></div>
  <div
    class="relative mx-4 w-full max-w-xs bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-2xl p-6 shadow-2xl"
    style="transform: scale(0.96); transition: transform 200ms ease"
    id="logout-modal-card"
  >
    <!-- Icon -->
    <div class="flex justify-center mb-4">
      <div class="w-12 h-12 rounded-full bg-red-950/40 border border-red-900/40 flex items-center justify-center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-red-400">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline stroke-linecap="round" stroke-linejoin="round" points="16 17 21 12 16 7"/>
          <line stroke-linecap="round" x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </div>
    </div>

    <h2 id="logout-modal-title" class="text-base font-semibold text-[var(--color-text)] text-center mb-1">
      Log off?
    </h2>
    <p class="text-sm text-[var(--color-text-muted)] text-center mb-6">
      You'll need your PIN to get back in.
    </p>

    <div class="flex flex-col gap-2">
      <button
        id="logout-confirm"
        class="h-11 rounded-xl bg-red-600 hover:bg-red-700 active:scale-[0.98] text-white text-sm font-semibold transition-all"
      >
        Log off
      </button>
      <button
        id="logout-cancel"
        class="h-11 rounded-xl text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-3)] active:scale-[0.98] transition-all"
      >
        Cancel
      </button>
    </div>
  </div>
</div>

<style>
  .nav-rail {
    height: var(--bottom-nav-height);
    padding-bottom: env(safe-area-inset-bottom);
  }

  @media (min-width: 1024px) {
    .nav-rail {
      top: var(--header-height);
      height: calc(100dvh - var(--header-height));
      width: var(--sidebar-width-desktop);
      padding-bottom: 0;
      transition: width 250ms cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  /* Desktop link states */
  .nav-desktop-link {
    color: var(--color-text-muted);
  }
  .nav-desktop-link:hover {
    background-color: color-mix(in srgb, var(--color-surface-3) 60%, transparent);
    color: var(--color-text);
  }
  .nav-desktop-link[aria-current="page"] {
    background-color: var(--color-surface-3);
    color: var(--color-accent);
  }

  /* Log off button (desktop) */
  .nav-logout-btn {
    color: var(--color-text-muted);
  }
  .nav-logout-btn:hover {
    background-color: color-mix(in srgb, #dc2626 12%, transparent);
    color: #f87171;
  }

  /* Mobile link states */
  .nav-mobile-link {
    color: var(--color-text-muted);
  }
  .nav-mobile-link:hover {
    color: var(--color-text);
  }
  .nav-mobile-link[aria-current="page"] {
    color: var(--color-accent);
  }
  .nav-mobile-link[aria-current="page"] .nav-mobile-pill {
    background-color: var(--color-surface-3);
  }
  .nav-mobile-link[aria-expanded="true"] {
    color: var(--color-text);
  }
  .nav-mobile-link[aria-expanded="true"] .nav-mobile-pill {
    background-color: var(--color-surface-3);
  }

  /* Collapsed sidebar */
  :global(:root[data-sidebar-collapsed]) .nav-label,
  :global(:root[data-sidebar-collapsed]) .nav-category {
    display: none;
  }
  :global(:root[data-sidebar-collapsed]) #toggle-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  function updateActiveState() {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('#sidebar a[href]').forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      const isActive = href === path || (href !== '/' && path.startsWith(href));
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function initSidebar() {
    updateActiveState();

    const toggle = document.getElementById('sidebar-toggle');
    if (!toggle) return;

    const STORAGE_KEY = 'substash:sidebar';
    const COLLAPSED_WIDTH = '64px';
    const EXPANDED_WIDTH = '240px';

    function applyState(collapsed: boolean) {
      if (collapsed) {
        document.documentElement.style.setProperty('--sidebar-width-desktop', COLLAPSED_WIDTH);
        document.documentElement.setAttribute('data-sidebar-collapsed', '');
      } else {
        document.documentElement.style.setProperty('--sidebar-width-desktop', EXPANDED_WIDTH);
        document.documentElement.removeAttribute('data-sidebar-collapsed');
      }
    }

    const isCurrentlyCollapsed = document.documentElement.hasAttribute('data-sidebar-collapsed');
    applyState(isCurrentlyCollapsed);

    const newToggle = toggle.cloneNode(true) as HTMLButtonElement;
    toggle.replaceWith(newToggle);
    newToggle.addEventListener('click', () => {
      const nowCollapsed = !document.documentElement.hasAttribute('data-sidebar-collapsed');
      applyState(nowCollapsed);
      localStorage.setItem(STORAGE_KEY, nowCollapsed ? 'collapsed' : 'expanded');
    });
  }

  // ── Drawer ───────────────────────────────────────────────────────────────────

  function openDrawer() {
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const trigger = document.getElementById('mobile-menu-trigger');
    drawer?.classList.remove('translate-y-full');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    trigger?.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const trigger = document.getElementById('mobile-menu-trigger');
    drawer?.classList.add('translate-y-full');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    trigger?.setAttribute('aria-expanded', 'false');
  }

  // ── Logout modal ─────────────────────────────────────────────────────────────

  let _prevFocus: HTMLElement | null = null;

  function openLogoutModal() {
    const modal = document.getElementById('logout-modal');
    const card = document.getElementById('logout-modal-card');
    if (!modal || !card) return;
    _prevFocus = document.activeElement as HTMLElement;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    card.style.transform = 'scale(1)';
    // Move focus to Cancel (safer default for destructive action)
    setTimeout(() => (document.getElementById('logout-cancel') as HTMLElement)?.focus(), 50);
    document.addEventListener('keydown', handleModalKeydown);
  }

  function closeLogoutModal() {
    const modal = document.getElementById('logout-modal');
    const card = document.getElementById('logout-modal-card');
    if (!modal || !card) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    card.style.transform = 'scale(0.96)';
    document.removeEventListener('keydown', handleModalKeydown);
    _prevFocus?.focus();
    _prevFocus = null;
  }

  function handleModalKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeLogoutModal();
      return;
    }
    if (e.key === 'Tab') {
      const focusable = Array.from(
        document.querySelectorAll<HTMLElement>('#logout-modal button:not([disabled])')
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  async function performLogout() {
    const confirmBtn = document.getElementById('logout-confirm') as HTMLButtonElement | null;
    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Logging off…';
    }
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
    } catch { /* best-effort */ }
    localStorage.removeItem('substash:session');
    sessionStorage.clear();
    window.location.href = '/auth';
  }

  // ── Init ─────────────────────────────────────────────────────────────────────

  function initDrawerAndModal() {
    // Drawer trigger
    document.getElementById('mobile-menu-trigger')?.addEventListener('click', openDrawer);
    document.getElementById('mobile-drawer-backdrop')?.addEventListener('click', closeDrawer);

    // Close drawer on drawer-link navigation
    document.querySelectorAll('.drawer-link').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    // Logout triggers (desktop sidebar + mobile drawer)
    document.querySelectorAll('[data-logout-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        closeDrawer();
        openLogoutModal();
      });
    });

    // Modal controls
    document.getElementById('logout-cancel')?.addEventListener('click', closeLogoutModal);
    document.getElementById('logout-modal-backdrop')?.addEventListener('click', closeLogoutModal);
    document.getElementById('logout-confirm')?.addEventListener('click', performLogout);

    // Close drawer on page navigation (view transitions)
    closeDrawer();
  }

  initSidebar();
  initDrawerAndModal();
  document.addEventListener('astro:page-load', () => {
    initSidebar();
    initDrawerAndModal();
  });
</script>
